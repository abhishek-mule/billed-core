NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@billzo.com

# OCR API
NEXT_PUBLIC_OCR_API_URL=https://your-ocr-service.com

# Firebase Auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Push Notifications (FCM)
# Client: Web Push Certificate key pair from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push Certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server: paste the FULL contents of the downloaded serviceAccountKey.json (single line) from
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key.
# The server uses this to send remote push (no local file path on Vercel).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gupshup WhatsApp
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=billzo

# WhatsApp provider (gupshup | baileys)
WHATSAPP_PROVIDER=gupshup

# Redis (required for Baileys session storage)
UPSTASH_REDIS_URL=rediss://default:TOKEN@HOST:PORT


# Cron secret
CRON_SECRET=

# Razorpay webhook secret
RAZORPAY_WEBHOOK_SECRET=

# Gemini AI
NEXT_PUBLIC_GEMINI_API_KEY=

# Meta Cloud API (WhatsApp) — placeholders only. NEVER commit real tokens.
# If a real token was ever committed here, rotate it in Meta dashboard immediately.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Worker inter-service auth (B-01) — signs Next.js → worker requests.
# Must match WORKER_INTERNAL_SECRET in the worker env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_INTERNAL_SECRET=
