# ============================================================
# BillZo Worker — Local Environment Configuration (EXAMPLE)
# ============================================================
# Copy this file to .env.local and fill in the values.
# The worker will NOT connect to the authority database
# without AUTHORITY_DATABASE_URL set; it falls back to
# polling-based outbox processing (less efficient).
#
# NOTE: This file MUST contain only placeholders. Never commit
# real credentials. Real values live in your local .env.local
# (gitignored) or in your deployment secret manager.
# ============================================================

# Supabase (required) — already set in .env
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Redis (required) — already set in .env
UPSTASH_REDIS_REST_URL=<YOUR_UPSTASH_REDIS_REST_URL>
UPSTASH_REDIS_REST_TOKEN=<YOUR_UPSTASH_REDIS_REST_TOKEN>
UPSTASH_REDIS_URL=redis://localhost:6379

# JWT secret — already set in .env
JWT_SECRET=<YOUR_JWT_SECRET>

# ── Authority Database (Postgres direct connection) ──
# Required for:
#   1. Outbox LISTEN/NOTIFY (push-based event processing)
#   2. Authority persistence layer (policy, capability registry)
#   3. MutationGate shadow mode
#
# Use Supabase direct connection (port 5432) or pooled (port 6543).
# Get the password from: Supabase Dashboard → Project Settings → Database
#
# Direct connection:
# AUTHORITY_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<PROJECT_REF>.supabase.co:5432/postgres
#
# Pooled connection (recommended for production):
# AUTHORITY_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Migration / Backfill (Neon → Supabase transition) ──
# After migrating all data from Neon to Supabase, set:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<PROJECT_REF>.supabase.co:5432/postgres

# ── Pilot Reminder Channel: BillZo-owned Meta WABA ──
# During the pilot BillZo operates one Meta Cloud API WhatsApp Business Account on
# behalf of every merchant. These credentials seed the system channel; merchants
# never see or configure them. See FIRST_MERCHANT_PLAYBOOK.md (Scenario A).
# If unset, reminders will not send — verify GET /api/channel/health returns active.
META_ACCESS_TOKEN=<YOUR_META_SYSTEM_ACCESS_TOKEN>
META_PHONE_NUMBER_ID=<YOUR_META_PHONE_NUMBER_ID>
META_WABA_ID=<YOUR_META_WABA_ID>
