{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@billzo/shared": ["./node_modules/@billzo/shared/dist/index.d.ts"],
      "@billzo/shared/*": ["./node_modules/@billzo/shared/dist/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts/staging-recovery-credits-verify.ts",
    "scripts/staging-escalations-verify.ts",
    "scripts/staging-webhook-inbox-verify.ts"
  ]
}
